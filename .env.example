# Supabase (REQUIRED - get these from https://app.supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role key (REQUIRED for guest checkout to persist bookings.
# This bypasses RLS - keep it server-side only, NEVER expose in frontend code.
# Get it from Supabase > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials for create-admin.js and test-login.js
ADMIN_EMAIL=admin@nextgen.com
ADMIN_PASSWORD=your-admin-password

# Paystack (REQUIRED for payments - get from https://dashboard.paystack.com/#/settings/developers)
# Use pk_live_/sk_live_ keys in production. If pk_test_ is set, the site shows
# a visible TEST MODE banner and no real charge occurs.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Confirmation emails (OPTIONAL - booking is saved without this. Get from https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=NextGen Travel <bookings@nextgentravel.com>
